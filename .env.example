# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# Contas (lib/conta.ts)
# ---------------------------------------------------------------------------
# Chave secreta do projeto (Project Settings > API Keys). Ignora a RLS inteira.
#
# SO NA SUA MAQUINA — nunca nas variaveis da Vercel. O site em producao nao
# precisa dela: o primeiro acesso e um signInWithPassword comum e a troca de
# senha e um updateUser, os dois com a chave publicavel. Quem usa esta e o
# scripts/criar-usuario.ts, rodado a mao.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Testes contra o banco (scripts/testar-pastas.ts)
# ---------------------------------------------------------------------------
# Segredo JWT do projeto (Project Settings > JWT Keys), em HS256 — o legado, que
# o painel marca como "still used, used only to verify JWTs".
#
# Serve para o script assinar um token de USUARIO e exercitar a RLS pelo mesmo
# caminho da tela. Usar a chave secreta seria mais facil e testaria a coisa
# errada: ela ignora a RLS, que e justamente o que o teste verifica.
#
# SO NA SUA MAQUINA. Nao precisa existir na Vercel — nasceu para o bot do
# Discord, aposentado em 2026-09-22 (ver docs/bot-discord.md), e nenhum codigo
# de producao a usa.
SUPABASE_JWT_SECRET=
