# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# Contas (lib/conta.ts)
# ---------------------------------------------------------------------------
# Chave secreta do projeto (Project Settings > API Keys). Ignora a RLS inteira.
#
# SO NA SUA MAQUINA — nunca nas variaveis da Vercel. O site em producao nao
# precisa dela: o primeiro acesso e um signInWithPassword comum e a troca de
# senha e um updateUser, os dois com a chave publicavel. Quem usa esta e o
# scripts/criar-usuario.ts, rodado a mao.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Bot do Discord (docs/bot-discord.md)
# ---------------------------------------------------------------------------
# NADA aqui pode ganhar o prefixo NEXT_PUBLIC_: tudo com esse prefixo vai para o
# bundle do navegador (diretriz 26). Estes quatro são segredos de servidor.

# Segredo JWT do projeto Supabase (Project Settings > JWT Keys).
# O bot assina com ele um token com `sub` = usuario_id, para que a RLS continue
# sendo quem isola os dados — e não o codigo do bot.
# ATENCAO: e o segredo HS256 LEGADO. Projetos que migraram para chaves
# assimetricas (ES256) so aceitam HS256 enquanto o legado nao for revogado.
SUPABASE_JWT_SECRET=

# Discord Developer Portal > sua aplicacao.
# Public Key: verifica a assinatura Ed25519 de toda interacao. Sem ela o
# endpoint recusa tudo — e o Discord recusa registrar a URL.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Usados so por scripts/registrar-comandos.ts, nao pelo endpoint em producao.
# O token do bot NAO precisa existir na Vercel: o follow-up das interacoes se
# autentica com o token da propria interacao.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
